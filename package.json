/**
 * Kaiwa Server — v6
 * Clean Express server. No timeouts. No edge function nonsense.
 *
 * Routes:
 *   GET  /health              — health check
 *   POST /token               — issues a short-lived AssemblyAI upload token
 *   POST /transcribe/start    — submits audio URL to AssemblyAI, returns jobId
 *   GET  /transcribe/poll     — polls AssemblyAI for result
 *   POST /analyze             — streams GPT-4o analysis via SSE
 *
 * Deploy to Railway or Render — free tier, no timeout, one git push.
 * Set env vars: OPENAI_API_KEY, ASSEMBLYAI_KEY
 */

import 'dotenv/config';
import express from 'express';
import cors from 'cors';

const app  = express();
const PORT = process.env.PORT || 3000;

// ── Middleware ────────────────────────────────────────────────────────────────
app.use(cors()); // allow all origins — restrict to your domain in production
app.use(express.json({ limit: '1mb' })); // only JSON bodies, audio never touches this server

// ── Health check ──────────────────────────────────────────────────────────────
app.get('/health', (_, res) => res.json({ ok: true }));

// ── POST /token ───────────────────────────────────────────────────────────────
// Issues a short-lived AssemblyAI upload token.
// Browser uses this to upload audio directly to AssemblyAI — key never exposed.
app.post('/token', async (_, res) => {
  const key = process.env.ASSEMBLYAI_KEY;
  if (!key) return res.status(500).json({ error: 'ASSEMBLYAI_KEY not configured.' });

  try {
    const r = await fetch('https://api.assemblyai.com/v2/realtime/token', {
      method: 'POST',
      headers: { 'Authorization': key, 'Content-Type': 'application/json' },
      body: JSON.stringify({ expires_in: 3600 }),
    });

    // AssemblyAI doesn't have a generic upload token endpoint — 
    // instead we use a signed URL approach: return a one-time upload URL
    // by calling their upload endpoint ourselves and returning just the upload_url
    // Actually — simplest approach: return a temporary token for direct upload
    // We'll use the upload endpoint pattern below in /transcribe/start
    
    // For direct browser upload, we proxy just the upload step
    // Return the key scoped only for upload (not transcription)
    // Since AssemblyAI doesn't support scoped keys, we handle upload server-side
    // but keep it fast — upload is just a PUT, returns instantly with a URL
    
    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

// ── POST /transcribe/start ────────────────────────────────────────────────────
// Receives audio file from browser as multipart, streams it to AssemblyAI upload,
// then immediately submits transcription job. Returns jobId.
// Express has NO timeout by default — this will wait as long as needed.
app.post('/transcribe/start', express.raw({ type: '*/*', limit: '600mb' }), async (req, res) => {
  const key = process.env.ASSEMBLYAI_KEY;
  if (!key) return res.status(500).json({ error: 'ASSEMBLYAI_KEY not configured.' });

  try {
    // Step 1: Upload audio bytes to AssemblyAI
    // They accept raw binary — no multipart needed
    const uploadRes = await fetch('https://api.assemblyai.com/v2/upload', {
      method: 'POST',
      headers: {
        'Authorization': key,
        'Content-Type': 'application/octet-stream',
        'Transfer-Encoding': 'chunked',
      },
      body: req.body,
      // Node.js fetch has no timeout by default — will wait as long as needed
    });

    if (!uploadRes.ok) {
      const t = await uploadRes.text();
      return res.status(502).json({ error: `Upload failed (${uploadRes.status}): ${t.slice(0, 200)}` });
    }

    const { upload_url } = await uploadRes.json();

    // Step 2: Submit transcription job — instant
    const jobRes = await fetch('https://api.assemblyai.com/v2/transcript', {
      method: 'POST',
      headers: { 'Authorization': key, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        audio_url: upload_url,
        language_detection: true,  // auto-detect any language
        punctuate: true,
        format_text: true,
        disfluencies: false,       // clean up um/uh
      }),
    });

    if (!jobRes.ok) {
      const t = await jobRes.text();
      return res.status(502).json({ error: `Job submission failed (${jobRes.status}): ${t.slice(0, 200)}` });
    }

    const { id: jobId } = await jobRes.json();
    res.json({ jobId, status: 'processing' });

  } catch (e) {
    res.status(500).json({ error: 'Transcription failed: ' + e.message });
  }
});

// ── GET /transcribe/poll?jobId=xxx ────────────────────────────────────────────
app.get('/transcribe/poll', async (req, res) => {
  const key   = process.env.ASSEMBLYAI_KEY;
  const jobId = req.query.jobId;
  if (!key)   return res.status(500).json({ error: 'ASSEMBLYAI_KEY not configured.' });
  if (!jobId) return res.status(400).json({ error: 'Missing jobId.' });

  try {
    const r    = await fetch(`https://api.assemblyai.com/v2/transcript/${jobId}`, {
      headers: { 'Authorization': key },
    });
    const data = await r.json();

    if (data.status === 'error') {
      return res.json({ status: 'error', error: data.error || 'Transcription failed.' });
    }

    if (data.status !== 'completed') {
      return res.json({ status: 'processing' });
    }

    // Build clean segments from word timestamps (5-second chunks)
    const words = data.words || [];
    const segs  = [];
    let ss = null, se = 0, sw = [];

    for (const w of words) {
      if (ss === null) ss = w.start / 1000;
      se = w.end / 1000;
      sw.push(w.text);
      if (se - ss >= 5 || w === words[words.length - 1]) {
        segs.push({ start: ss, end: se, text: sw.join(' ') });
        ss = null; se = 0; sw = [];
      }
    }
    if (segs.length === 0 && data.text) {
      segs.push({ start: 0, end: 0, text: data.text });
    }

    res.json({
      status: 'done',
      result: {
        text:     data.text || '',
        language: data.language_code || null,
        segments: segs,
      },
    });

  } catch (e) {
    res.status(500).json({ error: 'Poll failed: ' + e.message });
  }
});

// ── POST /analyze ─────────────────────────────────────────────────────────────
// Streams GPT-4o analysis back via SSE.
// No timeout — Express doesn't impose one, and GPT-4o streaming keeps the connection alive.
app.post('/analyze', async (req, res) => {
  const key = process.env.OPENAI_API_KEY;
  if (!key) return res.status(500).json({ error: 'OPENAI_API_KEY not configured.' });

  const { transcript, segments = [], language = 'id', detectedLanguage = null } = req.body;
  if (!transcript?.trim()) return res.status(400).json({ error: 'Transcript is empty.' });

  const outputLangLabel =
    language === 'en'   ? 'English' :
    language === 'both' ? 'Indonesian and English (write every field in BOTH languages separated by a slash, e.g. "Rapat dimulai / Meeting started")' :
    'Indonesian (Bahasa Indonesia)';

  const srcRaw   = (detectedLanguage || '').trim().toLowerCase();
  const srcLang  = srcRaw || 'the original language';
  const srcLabel = srcLang === 'the original language' ? srcLang
    : srcLang.charAt(0).toUpperCase() + srcLang.slice(1);

  function fmt(s) {
    const m = Math.floor(s / 60), ss = Math.floor(s % 60);
    return `${m}:${ss.toString().padStart(2, '0')}`;
  }

  const originalTranscript = segments.length > 0
    ? segments.map(s => `[${s.startFormatted || fmt(s.start)}] [Speaker]: ${s.text}`).join('\n')
    : transcript;

  const segBlock = segments.length > 0
    ? segments.map(s => `[${s.startFormatted || fmt(s.start)}] ${s.text}`).join('\n')
    : transcript;
  const capped = segBlock.length > 14000
    ? segBlock.slice(0, 14000) + '\n[... truncated ...]'
    : segBlock;

  const systemPrompt = `You are a professional meeting analyst and translator. Analyze this transcript and return a structured JSON object.

Source language: ${srcLabel}
Output language: ${outputLangLabel}

LANGUAGE RULES — ABSOLUTE, NO EXCEPTIONS:
- Write ALL output fields in ${outputLangLabel}. Every single field. No exceptions.
- This includes: summary points, subPoints, keyPoints, highlights context, chapter titles, chapter summaries, speaker summaries, translated transcript lines — everything.
- Do NOT default to English unless the output language is English.
- Do NOT mix languages unless the output language explicitly says "both".
- If output is "both", write each field as "Indonesian text / English text".

CONTENT RULES — be specific, no filler:
- SPEAKERS: Identify each speaker. Use real names if mentioned, else Speaker A/B/C. Write a specific summary of their contribution.
- CHAPTERS: Divide by topic. Title = the actual topic discussed. No decisions or action items here.
- SUMMARY: Past-tense narrative. Include specific names, numbers, decisions. No vague generalities. Do NOT repeat key points verbatim.
- KEY POINTS: Only explicit decisions, commitments, and action items. Format: WHO will do WHAT. Nothing observational.
- HIGHLIGHTS: 2-4 quotes that are surprising, decisive, or reveal something important. Translate to output language. Explain concretely why each matters.
- TRANSCRIPT: Translate every utterance. Include fillers, short responses, everything. Format: "[M:SS] [Speaker Name]: text"

Speaker detection: real names if mentioned, else Speaker A/B/C. Consistent across all fields.
Translation: natural and contextual, never literal. Match the formality of the original.

CRITICAL: Return ONLY valid JSON. No markdown. No code fences. No text before or after the JSON object.

{
  "speakers": [{"id":"speaker_a","label":"Speaker A","name":null,"role":null,"summary":"specific contribution in output language"}],
  "chapters": [{"title":"Actual Topic","timestamp":"0:00 - 2:30","summary":"what happened in output language"}],
  "tabs": {
    "summary": [{"point":"specific finding in output language","subPoints":["detail","detail"]}],
    "keyPoints": [{"point":"WHO will do WHAT in output language","subPoints":["deadline or condition"]}],
    "highlights": [{"speaker":"Speaker A","quote":"exact quote translated to output language","context":"why this matters in output language"}]
  },
  "transcripts": {
    "translated": "[0:00] [Speaker A]: full translation\\n[0:05] [Speaker B]: translation"
  }
}`;

  // Set SSE headers
  res.setHeader('Content-Type', 'text/event-stream');
  res.setHeader('Cache-Control', 'no-cache');
  res.setHeader('Connection', 'keep-alive');
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.flushHeaders();

  const send = (obj) => res.write(`data: ${JSON.stringify(obj)}\n\n`);
  const hb   = setInterval(() => send({ ping: true }), 5000);

  try {
    const gpt = await fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${key}` },
      body: JSON.stringify({
        model: 'gpt-4o',
        max_tokens: 8192,
        temperature: 0.1,
        stream: true,
        messages: [
          { role: 'system', content: systemPrompt },
          { role: 'user',   content: `Timestamped transcript to analyze and translate:\n${capped}` },
        ],
      }),
    });

    if (!gpt.ok) {
      const t = await gpt.text();
      let msg = `OpenAI error (${gpt.status})`;
      try { msg = JSON.parse(t).error?.message || msg; } catch {}
      send({ error: msg }); res.end(); return;
    }

    let acc = '', lineBuf = '';
    const reader = gpt.body.getReader();
    const dec    = new TextDecoder();

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      lineBuf += dec.decode(value, { stream: true });
      let nl;
      while ((nl = lineBuf.indexOf('\n')) !== -1) {
        const line = lineBuf.slice(0, nl).trimEnd();
        lineBuf = lineBuf.slice(nl + 1);
        if (!line.startsWith('data: ')) continue;
        const raw = line.slice(6).trim();
        if (raw === '[DONE]') continue;
        let p; try { p = JSON.parse(raw); } catch { continue; }
        const token = p.choices?.[0]?.delta?.content;
        if (token) { acc += token; send({ token }); }
      }
    }

    const clean = acc.replace(/^```json\s*/m,'').replace(/^```\s*/m,'').replace(/\s*```$/m,'').trim();
    const s = clean.indexOf('{'), e = clean.lastIndexOf('}');
    const jsonStr = s !== -1 && e !== -1 ? clean.slice(s, e+1) : clean;

    let result;
    try { result = JSON.parse(jsonStr); }
    catch { send({ error: 'Failed to parse analysis. Try a shorter recording.' }); res.end(); return; }

    if (!result.transcripts) result.transcripts = {};
    result.transcripts.translated = result.transcripts.translated || '';
    result.transcripts.original   = originalTranscript;
    result._meta = { sourceLang: srcLabel, outputLang: language };

    send({ done: true, result });

  } catch (e) {
    send({ error: 'Analysis failed: ' + e.message });
  } finally {
    clearInterval(hb);
    res.end();
  }
});

// ── Start ─────────────────────────────────────────────────────────────────────
app.listen(PORT, () => console.log(`Kaiwa server running on port ${PORT}`));
